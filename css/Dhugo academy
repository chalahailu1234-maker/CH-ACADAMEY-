* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f7fa;
    color: #222;
    line-height: 1.6;
}

/* Header */
header {
    background: #2563eb;
    color: white;
    text-align: center;
    padding: 30px 20px;
}

header h1 {
    font-size: 40px;
    margin-bottom: 8px;
}

/* Navigation */
nav {
    background: white;
    padding: 18px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

nav a {
    color: #2563eb;
    text-decoration: none;
    font-weight: bold;
    margin: 0 12px;
}

nav a:hover {
    color: #1d4ed8;
}

/* Hero */
.hero {
    text-align: center;
    padding: 70px 20px;
}

.hero h1 {
    font-size: 42px;
    color: #1e3a8a;
    margin-bottom: 15px;
}

.hero p {
    font-size: 18px;
    margin-bottom: 25px;
}

/* Button */
button {
    background: #2563eb;
    color: white;
    border: none;
    padding: 13px 28px;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background: #1d4ed8;
}

/* Sections */
section {
    padding: 45px 20px;
    text-align: center;
}

section h2 {
    color: #1e3a8a;
    margin-bottom: 20px;
}

/* Footer */
footer {
    background: #111827;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 30px;
}

/* Phone */
@media (max-width: 600px) {
    header h1 {
        font-size: 30px;
    }

    .hero h1 {
        font-size: 30px;
    }

    nav a {
        display: inline-block;
        margin: 5px;
    }
}
