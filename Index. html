<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>CH AI</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f7f7f8;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Header */
    header {
      height: 60px;
      background: #ffffff;
      border-bottom: 1px solid #ddd;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 15px;
    }

    .logo {
      font-size: 21px;
      font-weight: bold;
      color: #1565c0;
    }

    #newChat {
      border: none;
      background: #1565c0;
      color: white;
      padding: 9px 14px;
      border-radius: 8px;
      cursor: pointer;
    }

    /* Chat area */
    #chat {
      flex: 1;
      overflow-y: auto;
      padding: 20px 15px 100px;
    }

    .message {
      display: flex;
      margin-bottom: 18px;
      gap: 10px;
    }

    .avatar {
      width: 35px;
      height: 35px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      flex-shrink: 0;
    }

    .user .avatar {
      background: #1565c0;
    }

    .ai .avatar {
      background: #333;
    }

    .content {
      max-width: 80%;
      padding: 10px 13px;
      border-radius: 12px;
      line-height: 1.5;
      white-space: pre-wrap;
    }

    .user .content {
      background: #e3f2fd;
    }

    .ai .content {
      background: white;
      border: 1px solid #e0e0e0;
    }

    /* Input area */
    .input-area {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: white;
      border-top: 1px solid #ddd;
      padding: 10px;
    }

    .input-box {
      max-width: 800px;
      margin: auto;
      display: flex;
      gap: 8px;
    }

    #messageInput {
      flex: 1;
      border: 1px solid #ccc;
      border-radius: 12px;
      padding: 13px;
      outline: none;
      font-size: 16px;
    }

    #sendBtn {
      width: 50px;
      border: none;
      border-radius: 12px;
      background: #1565c0;
      color: white;
      font-size: 20px;
      cursor: pointer;
    }

    #sendBtn:active {
      transform: scale(0.95);
    }

    .welcome {
      text-align: center;
      margin-top: 25vh;
    }

    .welcome h1 {
      color: #1565c0;
      margin-bottom: 10px;
    }

    .welcome p {
      color: #666;
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">🤖 CH AI</div>
    <button id="newChat">＋ New Chat</button>
  </header>

  <main id="chat">

    <div class="welcome" id="welcome">
      <h1>How can I help you?</h1>
      <p>Welcome to CH AI 🤖</p>
    </div>

  </main>

  <div class="input-area">
    <div class="input-box">

      <input
        type="text"
        id="messageInput"
        placeholder="Message CH AI..."
      >

      <button id="sendBtn">➤</button>

    </div>
  </div>

  <script>

    const chat = document.getElementById("chat");
    const input = document.getElementById("messageInput");
    const sendBtn = document.getElementById("sendBtn");
    const newChat = document.getElementById("newChat");
    const welcome = document.getElementById("welcome");

    function addMessage(text, type) {

      if (welcome) {
        welcome.remove();
      }

      const message = document.createElement("div");
      message.className = "message " + type;

      const avatar = document.createElement("div");
      avatar.className = "avatar";

      avatar.textContent = type === "user" ? "You" : "AI";

      const content = document.createElement("div");
      content.className = "content";
      content.textContent = text;

      message.appendChild(avatar);
      message.appendChild(content);

      chat.appendChild(message);

      chat.scrollTop = chat.scrollHeight;
    }

    function sendMessage() {

      const text = input.value.trim();

      if (text === "") {
        return;
      }

      addMessage(text, "user");

      input.value = "";

      // Temporary AI response
      setTimeout(() => {

        let reply;

        if (text.toLowerCase().includes("hello") ||
            text.toLowerCase().includes("hi")) {

          reply = "Hello! 👋 How can I help you?";

        } else if (text.toLowerCase().includes("python")) {

          reply = "Python is a beginner-friendly programming language 🐍.";

        } else if (text.toLowerCase().includes("who are you")) {

          reply = "I am CH AI, your AI assistant 🤖.";

        } else {

          reply = "I received your message: " + text +
                  "\n\nAI API itti hin hidhamne. Yeroo ammaa demo mode keessa jira.";

        }

        addMessage(reply, "ai");

      }, 700);
    }

    sendBtn.addEventListener("click", sendMessage);

    input.addEventListener("keydown", function(event) {

      if (event.key === "Enter") {
        sendMessage();
      }

    });

    newChat.addEventListener("click", function() {

      chat.innerHTML = `
        <div class="welcome" id="welcome">
          <h1>How can I help you?</h1>
          <p>Welcome to CH AI 🤖</p>
        </div>
      `;

    });

  </script>

</body>
</html>